@page "/nuget/packages"
@inherits ViewModelPage<ProjectPackagesViewModel>
@inject UiLocalizer L

<h1><i class="fa-solid fa-box-open me-2"></i>@L["ProjectPackages.Title"]</h1>

<div class="toolbar">
	<button class="btn btn-primary btn-sm" disabled="@ViewModel.IsBusy" @onclick="ViewModel.RefreshAsync">
		<i class="fa-solid fa-rotate @(ViewModel.IsBusy ? "fa-spin" : string.Empty)"></i> @L["ProjectPackages.CheckAll"]
	</button>
	<button class="btn btn-outline-secondary btn-sm" disabled="@ViewModel.IsBusy" @onclick="ViewModel.PickDirectoryAsync">
		<i class="fa-solid fa-folder-open"></i> @L["Common.SelectFolder"]
	</button>
	<button class="btn btn-outline-secondary btn-sm" disabled="@ViewModel.IsBusy" @onclick="ViewModel.PickFileAsync">
		<i class="fa-solid fa-file-code"></i> @L["ProjectPackages.SelectFile"]
	</button>
	<button class="btn btn-warning btn-sm" disabled="@(ViewModel.IsBusy || ViewModel.OutdatedCount == 0)" @onclick="ViewModel.UpgradeAllAsync">
		<i class="fa-solid fa-arrow-up-right-from-square"></i> @L["ProjectPackages.UpgradeAll"] (@ViewModel.OutdatedCount)
	</button>
	<span class="spacer"></span>
	<button class="btn btn-outline-secondary btn-sm" @onclick="ViewModel.OpenCurrentFolder">
		<i class="fa-solid fa-arrow-up-right-from-square"></i> @L["Common.OpenFolder"]
	</button>
</div>

<div class="row g-2 mb-3">
	<div class="col-md-7">
		<label class="hint" for="workingDirectory">@L["Common.WorkingDirectory"]</label>
		<input id="workingDirectory" class="form-control form-control-sm path-box" readonly value="@ViewModel.WorkingDirectory" />
	</div>
	@if (ViewModel.AvailableTargets.Count > 1)
	{
		<div class="col-md-5">
			<label class="hint" for="targetSelect">@L["ProjectPackages.TargetProject"]</label>
			<select id="targetSelect" class="form-select form-select-sm path-box"
					value="@ViewModel.SelectedTargetPath"
					@onchange="OnTargetSelected">
				@foreach (var target in ViewModel.AvailableTargets)
				{
					<option value="@target.TargetPath">@target.DisplayName</option>
				}
			</select>
		</div>
	}
</div>

<div class="d-flex flex-wrap align-items-center gap-3 mb-3">
	<div class="form-check">
		<input class="form-check-input" type="checkbox" id="checkTransitive"
			   checked="@ViewModel.IncludeTransitive"
			   disabled="@ViewModel.IsBusy"
			   @onchange="ViewModel.ToggleTransitiveAsync" />
		<label class="form-check-label" for="checkTransitive">@L["ProjectPackages.IncludeTransitive"]</label>
	</div>
	<div class="form-check">
		<input class="form-check-input" type="checkbox" id="checkPrerelease"
			   checked="@ViewModel.IncludePrerelease"
			   disabled="@ViewModel.IsBusy"
			   @onchange="ViewModel.TogglePrereleaseAsync" />
		<label class="form-check-label" for="checkPrerelease">@L["ProjectPackages.IncludePrerelease"]</label>
	</div>
	@if (ViewModel.IsCheckingOutdated)
	{
		<span class="hint text-primary"><i class="fa-solid fa-spinner fa-spin"></i> @L["ProjectPackages.CheckOutdated"]…</span>
	}
	@if (ViewModel.IsCheckingVulnerabilities)
	{
		<span class="hint text-danger"><i class="fa-solid fa-shield-halved fa-spin"></i> @L["ProjectPackages.CheckVulnerabilities"]…</span>
	}
</div>

<!-- Summary Statistic Cards -->
<div class="row g-3 mb-3">
	<div class="col-sm-6 col-lg-3">
		<div class="card stat-card @(ViewModel.FilterMode == PackageFilterMode.All ? "active-stat" : "")"
			 role="button" @onclick="() => ViewModel.SetFilter(PackageFilterMode.All)">
			<div class="card-body py-2 px-3">
				<div class="text-muted small">@L["ProjectPackages.TotalPackages"]</div>
				<div class="fs-4 fw-bold">@ViewModel.TotalCount</div>
			</div>
		</div>
	</div>
	<div class="col-sm-6 col-lg-3">
		<div class="card stat-card @(ViewModel.VulnerableCount > 0 ? "stat-danger" : "") @(ViewModel.FilterMode == PackageFilterMode.VulnerableOnly ? "active-stat" : "")"
			 role="button" @onclick="() => ViewModel.SetFilter(PackageFilterMode.VulnerableOnly)">
			<div class="card-body py-2 px-3">
				<div class="text-danger small fw-semibold">
					<i class="fa-solid fa-triangle-exclamation"></i> @L["ProjectPackages.VulnerableCount"]
				</div>
				<div class="fs-4 fw-bold text-danger">@ViewModel.VulnerableCount</div>
			</div>
		</div>
	</div>
	<div class="col-sm-6 col-lg-3">
		<div class="card stat-card @(ViewModel.OutdatedCount > 0 ? "stat-warning" : "") @(ViewModel.FilterMode == PackageFilterMode.OutdatedOnly ? "active-stat" : "")"
			 role="button" @onclick="() => ViewModel.SetFilter(PackageFilterMode.OutdatedOnly)">
			<div class="card-body py-2 px-3">
				<div class="text-warning-emphasis small fw-semibold">
					<i class="fa-solid fa-arrow-up"></i> @L["ProjectPackages.OutdatedCount"]
				</div>
				<div class="fs-4 fw-bold text-warning-emphasis">@ViewModel.OutdatedCount</div>
			</div>
		</div>
	</div>
	<div class="col-sm-6 col-lg-3">
		<div class="card stat-card @(ViewModel.FilterMode == PackageFilterMode.UpToDateOnly ? "active-stat" : "")"
			 role="button" @onclick="() => ViewModel.SetFilter(PackageFilterMode.UpToDateOnly)">
			<div class="card-body py-2 px-3">
				<div class="text-success small fw-semibold">
					<i class="fa-solid fa-circle-check"></i> @L["ProjectPackages.UpToDateCount"]
				</div>
				<div class="fs-4 fw-bold text-success">@ViewModel.UpToDateCount</div>
			</div>
		</div>
	</div>
</div>

<OperationPanel HasOutput="@ViewModel.HasOutput"
				OutputText="@ViewModel.OutputText"
				StatusIsError="@ViewModel.StatusIsError"
				StatusMessage="@ViewModel.StatusMessage" />

<!-- Filters & Search Toolbar -->
<div class="card mb-3">
	<div class="card-body py-2">
		<div class="row g-2 align-items-center">
			<div class="col-md-5">
				<div class="input-group input-group-sm">
					<span class="input-group-text"><i class="fa-solid fa-magnifying-glass"></i></span>
					<input class="form-control" placeholder="@L["ProjectPackages.SearchPlaceholder"]"
						   @bind="ViewModel.SearchText" @bind:event="oninput" />
				</div>
			</div>
			<div class="col-md-7">
				<div class="btn-group btn-group-sm w-100 flex-wrap" role="group">
					<button class="btn @(ViewModel.FilterMode == PackageFilterMode.All ? "btn-primary" : "btn-outline-secondary")"
							@onclick="() => ViewModel.SetFilter(PackageFilterMode.All)">
						@L["ProjectPackages.FilterAll"] (@ViewModel.TotalCount)
					</button>
					<button class="btn @(ViewModel.FilterMode == PackageFilterMode.VulnerableOnly ? "btn-danger" : "btn-outline-danger")"
							@onclick="() => ViewModel.SetFilter(PackageFilterMode.VulnerableOnly)">
						<i class="fa-solid fa-shield-virus"></i> @L["ProjectPackages.FilterVulnerable"] (@ViewModel.VulnerableCount)
					</button>
					<button class="btn @(ViewModel.FilterMode == PackageFilterMode.OutdatedOnly ? "btn-warning" : "btn-outline-secondary")"
							@onclick="() => ViewModel.SetFilter(PackageFilterMode.OutdatedOnly)">
						<i class="fa-solid fa-arrow-up"></i> @L["ProjectPackages.FilterOutdated"] (@ViewModel.OutdatedCount)
					</button>
					<button class="btn @(ViewModel.FilterMode == PackageFilterMode.UpToDateOnly ? "btn-success" : "btn-outline-secondary")"
							@onclick="() => ViewModel.SetFilter(PackageFilterMode.UpToDateOnly)">
						<i class="fa-solid fa-check"></i> @L["ProjectPackages.FilterUpToDate"] (@ViewModel.UpToDateCount)
					</button>
					<button class="btn @(ViewModel.FilterMode == PackageFilterMode.TopLevelOnly ? "btn-secondary" : "btn-outline-secondary")"
							@onclick="() => ViewModel.SetFilter(PackageFilterMode.TopLevelOnly)">
						@L["ProjectPackages.FilterTopLevel"]
					</button>
					<button class="btn @(ViewModel.FilterMode == PackageFilterMode.TransitiveOnly ? "btn-secondary" : "btn-outline-secondary")"
							@onclick="() => ViewModel.SetFilter(PackageFilterMode.TransitiveOnly)">
						@L["ProjectPackages.FilterTransitive"]
					</button>
				</div>
			</div>
		</div>
	</div>
</div>

@if (ViewModel.Packages.Count == 0 && !ViewModel.IsBusy)
{
	<div class="alert alert-info">
		<i class="fa-solid fa-circle-info me-1"></i> @L["ProjectPackages.NoPackagesFound"]
	</div>
}
else
{
	<div class="table-responsive">
		<table class="table table-sm table-hover grid package-table">
			<thead>
				<tr>
					<th style="width: 110px">@L["Common.Status"]</th>
					<th>@L["Common.Name"]</th>
					<th>@L["ProjectPackages.TargetProject"]</th>
					<th>@L["ProjectPackages.ResolvedVersion"]</th>
					<th>@L["ProjectPackages.LatestVersion"]</th>
					<th>@L["ProjectPackages.Vulnerabilities"]</th>
					<th style="width: 100px; text-align: right">@L["Common.Actions"]</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var pkg in ViewModel.FilteredPackages)
				{
					var rowClass = pkg.HasVulnerabilities
						? "row-vulnerable"
						: pkg.IsOutdated
							? "row-outdated"
							: string.Empty;

					<tr class="@rowClass">
						<td>
							@if (pkg.HasVulnerabilities)
							{
								<span class="badge text-bg-danger" title="@L["ProjectPackages.VulnerableTitle"]">
									<i class="fa-solid fa-triangle-exclamation"></i> @L["ProjectPackages.StatusVulnerable"]
								</span>
							}
							else if (pkg.IsOutdated)
							{
								<span class="badge text-bg-warning" title="@L["ProjectPackages.OutdatedTitle"]">
									<i class="fa-solid fa-arrow-up"></i> @L["ProjectPackages.StatusOutdated"]
								</span>
							}
							else
							{
								<span class="badge text-bg-success">
									<i class="fa-solid fa-check"></i> @L["ProjectPackages.StatusLatest"]
								</span>
							}

							@if (pkg.IsTransitive)
							{
								<span class="badge text-bg-secondary ms-1" title="@L["ProjectPackages.Transitive"]">@L["ProjectPackages.BadgeTransitive"]</span>
							}
							@if (pkg.IsAutoReferenced)
							{
								<span class="badge text-bg-secondary ms-1" title="@L["ProjectPackages.AutoReferenced"]"><i class="fa-solid fa-lock"></i></span>
							}
						</td>
						<td>
							<a href="https://www.nuget.org/packages/@pkg.PackageId" target="_blank" class="fw-semibold">
								<code>@pkg.PackageId</code>
							</a>
						</td>
						<td>
							<div class="fw-medium small">@pkg.ProjectName</div>
							@if (!string.IsNullOrWhiteSpace(pkg.Framework))
							{
								<span class="badge text-bg-secondary" style="font-size: 0.7rem">@pkg.Framework</span>
							}
						</td>
						<td>
							<code>@(pkg.ResolvedVersion ?? pkg.RequestedVersion ?? "-")</code>
							@if (!string.IsNullOrWhiteSpace(pkg.RequestedVersion) &&
								 !string.Equals(pkg.RequestedVersion, pkg.ResolvedVersion, StringComparison.OrdinalIgnoreCase))
							{
								<span class="hint d-block">req: @pkg.RequestedVersion</span>
							}
						</td>
						<td>
							@if (pkg.IsOutdated)
							{
								<span class="badge text-bg-warning fw-bold">
									<i class="fa-solid fa-arrow-up"></i> @pkg.LatestVersion
								</span>
							}
							else if (!string.IsNullOrWhiteSpace(pkg.LatestVersion))
							{
								<span class="text-success small"><i class="fa-solid fa-check"></i> @pkg.LatestVersion</span>
							}
							else
							{
								<span class="text-muted small">-</span>
							}
						</td>
						<td>
							@if (pkg.HasVulnerabilities)
							{
								<div class="vulnerabilities-list">
									@foreach (var v in pkg.Vulnerabilities)
									{
										var sevClass = v.SeverityWeight >= 3 ? "text-bg-danger" : "text-bg-warning";
										<div class="mb-1">
											<span class="badge @sevClass me-1">@v.Severity</span>
											@if (!string.IsNullOrWhiteSpace(v.Cve))
											{
												<span class="badge text-bg-danger me-1">@v.Cve</span>
											}
											@if (!string.IsNullOrWhiteSpace(v.AdvisoryUrl))
											{
												<a href="@v.AdvisoryUrl" target="_blank" class="small text-danger fw-semibold">
													<i class="fa-solid fa-up-right-from-square"></i> @L["ProjectPackages.Advisory"]
												</a>
											}
										</div>
									}
								</div>
							}
							else
							{
								<span class="text-success small"><i class="fa-solid fa-shield-halved"></i> @L["ProjectPackages.StatusSafe"]</span>
							}
						</td>
						<td style="text-align: right">
							@if (pkg.CanUpgrade && pkg.IsOutdated)
							{
								<button class="btn btn-primary btn-sm py-0 px-2"
										title="@L["ProjectPackages.UpgradeTitle"]"
										disabled="@ViewModel.IsBusy"
										@onclick="() => ViewModel.UpgradePackageAsync(pkg)">
									<i class="fa-solid fa-arrow-up"></i> @L["ProjectPackages.Upgrade"]
								</button>
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}

@code {
	protected override async Task OnInitializedAsync()
	{
		await ViewModel.InitializeAsync();
	}

	private async Task OnTargetSelected(ChangeEventArgs e)
	{
		var value = e.Value?.ToString();
		await ViewModel.SelectTargetAsync(string.IsNullOrWhiteSpace(value) ? null : value);
	}
}
