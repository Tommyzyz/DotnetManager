@page "/tools/local"
@inherits ViewModelPage<LocalToolsViewModel>
@inject UiLocalizer L

<h1>@L["Nav.LocalTools"]</h1>

<div class="toolbar">
	<button class="btn btn-primary btn-sm" disabled="@ViewModel.IsBusy" @onclick="ViewModel.RefreshAsync">
		<i class="fa-solid fa-rotate @(ViewModel.IsBusy ? "fa-spin" : string.Empty)"></i> @L["Common.Refresh"]
	</button>
	<button class="btn btn-outline-secondary btn-sm" disabled="@ViewModel.IsBusy" @onclick="ViewModel.PickDirectoryAsync">
		<i class="fa-solid fa-folder-open"></i> @L["Common.SelectFolder"]
	</button>
	<button class="btn btn-outline-secondary btn-sm" disabled="@ViewModel.IsBusy || ViewModel.HasManifest" @onclick="ViewModel.CreateManifestAsync">
		<i class="fa-solid fa-plus"></i> @L["LocalTools.CreateManifest"]
	</button>
	<button class="btn btn-outline-secondary btn-sm" disabled="@ViewModel.IsBusy || !ViewModel.HasManifest" @onclick="ViewModel.RestoreAsync">
		<i class="fa-solid fa-download"></i> @L["LocalTools.Restore"]
	</button>
	<button class="btn btn-outline-secondary btn-sm" disabled="@ViewModel.IsBusy || !ViewModel.HasManifest" @onclick="ViewModel.CheckUpdatesAsync">
		<i class="fa-solid fa-arrows-rotate"></i> @L["LocalTools.CheckUpdates"]
	</button>
	<button class="btn btn-outline-secondary btn-sm" disabled="@ViewModel.IsBusy || !ViewModel.HasManifest" @onclick="ViewModel.UpdateAllAsync">
		<i class="fa-solid fa-arrow-up-right-from-square"></i> @L["LocalTools.UpdateAll"]
	</button>
	<span class="spacer"></span>
	<button class="btn btn-outline-secondary btn-sm" disabled="@(!ViewModel.HasManifest)" @onclick="ViewModel.OpenManifestFolder">
		<i class="fa-solid fa-folder-open"></i> @L["Common.OpenFolder"]
	</button>
</div>

<div class="mb-3">
	<label class="hint" for="workingDirectory">@L["Common.WorkingDirectory"]</label>
	<input id="workingDirectory" class="form-control form-control-sm path-box" readonly value="@ViewModel.WorkingDirectory" />
</div>

@if (ViewModel.ManifestPaths.Count > 1)
{
	<div class="mb-3">
		<label class="hint" for="manifestSelect">@L["LocalTools.Manifests"]</label>
		<select id="manifestSelect" class="form-select form-select-sm path-box"
				value="@ViewModel.SelectedManifestPath"
				@onchange="OnManifestSelected">
			@foreach (var path in ViewModel.ManifestPaths)
			{
				<option value="@path">@path</option>
			}
		</select>
	</div>
}

<OperationPanel HasOutput="@ViewModel.HasOutput"
				OutputText="@ViewModel.OutputText"
				StatusIsError="@ViewModel.StatusIsError"
				StatusMessage="@ViewModel.StatusMessage" />

@if (ViewModel.Manifest is not null)
{
	<p class="hint path-box mb-2">
		<i class="fa-solid fa-file-code"></i> @ViewModel.Manifest.Path
		@if (ViewModel.Manifest.IsRoot)
		{
			<span class="badge text-bg-info">isRoot</span>
		}
	</p>
}

<div class="card mb-3">
	<div class="card-body">
		<h2 class="h6 card-title">@L["LocalTools.Install"]</h2>
		<div class="toolbar mb-0">
			<input class="form-control form-control-sm" style="max-width: 18rem" placeholder="@L["LocalTools.PackageId"]"
				   @bind="ViewModel.NewPackageId" @bind:event="oninput" />
			<input class="form-control form-control-sm" style="max-width: 12rem" placeholder="@L["LocalTools.VersionPlaceholder"]"
				   @bind="ViewModel.NewPackageVersion" @bind:event="oninput" />
			<div class="form-check">
				<input class="form-check-input" type="checkbox" id="localPrerelease" @bind="ViewModel.InstallPrerelease" />
				<label class="form-check-label" for="localPrerelease">@L["Common.PreRelease"]</label>
			</div>
			<button class="btn btn-outline-secondary btn-sm" disabled="@ViewModel.IsBusy" @onclick="ViewModel.SearchPackageAsync">
				<i class="fa-solid fa-magnifying-glass"></i> @L["LocalTools.Lookup"]
			</button>
			<button class="btn btn-primary btn-sm" disabled="@ViewModel.IsBusy || !ViewModel.HasManifest" @onclick="ViewModel.InstallAsync">
				<i class="fa-solid fa-plus"></i> @L["Common.Install"]
			</button>
		</div>
	</div>
</div>

@if (!ViewModel.HasManifest)
{
	<p class="hint">@L["LocalTools.NoManifest"]</p>
}
else
{
	<table class="table table-sm table-hover grid">
		<thead>
			<tr>
				<th>@L["Common.Package"]</th>
				<th>@L["Common.Version"]</th>
				<th>@L["Common.Latest"]</th>
				<th>@L["Common.Commands"]</th>
				<th>rollForward</th>
				<th>@L["Common.Actions"]</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var tool in ViewModel.Tools)
			{
				<tr>
					<td><code>@tool.PackageId</code></td>
					<td>@tool.Version</td>
					<td>
						@if (tool.IsChecking)
						{
							<i class="fa-solid fa-spinner fa-spin"></i>
						}
						else if (tool.HasUpdate)
						{
							<span class="badge text-bg-warning">@tool.LatestVersion</span>
						}
						else
						{
							<span class="hint">@(tool.LatestVersion ?? "-")</span>
						}
					</td>
					<td><code>@tool.CommandText</code></td>
					<td>@(tool.RollForward ?? "-")</td>
					<td>
						<div class="toolbar mb-0">
							<button class="btn btn-outline-primary btn-sm" disabled="@ViewModel.IsBusy" @onclick="() => ViewModel.UpdateAsync(tool)">@L["Common.Update"]</button>
							<button class="btn btn-outline-secondary btn-sm" disabled="@ViewModel.IsBusy" @onclick="() => ViewModel.SetRollForwardAsync(tool)">rollForward</button>
							<button class="btn btn-outline-secondary btn-sm" disabled="@ViewModel.IsBusy || tool.Commands.Count == 0" @onclick="() => ViewModel.RunToolAsync(tool)">@L["LocalTools.Run"]</button>
							<button class="btn btn-outline-danger btn-sm" disabled="@ViewModel.IsBusy" @onclick="() => ViewModel.UninstallAsync(tool)">@L["Common.Uninstall"]</button>
							<button class="btn btn-outline-danger btn-sm" disabled="@ViewModel.IsBusy" @onclick="() => ViewModel.RemoveFromManifestAsync(tool)">@L["LocalTools.RemoveFromManifest"]</button>
						</div>
					</td>
				</tr>
			}
		</tbody>
	</table>
}

@code {
	protected override async Task OnInitializedAsync() => await ViewModel.InitializeAsync();

	private async Task OnManifestSelected(ChangeEventArgs args) =>
		await ViewModel.SelectManifestAsync(args.Value?.ToString() ?? string.Empty);
}
