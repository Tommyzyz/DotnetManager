<?xml version="1.0" encoding="UTF-8" ?>
<Application
    x:Class="DotnetManagerUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:DotnetManagerUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Other merged dictionaries here -->
            </ResourceDictionary.MergedDictionaries>
            <!-- Other app resources here -->

            <!-- The page content is Blazor/HTML and styles itself from wwwroot/css/app.css, so no
                 brushes or font sizes are declared here. The brushes that used to sit below
                 (Primary/White/Black + AppFontSize) had no consumer in any XAML or code file. -->
        </ResourceDictionary>
    </Application.Resources>
</Application>