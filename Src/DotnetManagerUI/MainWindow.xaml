<?xml version="1.0" encoding="UTF-8" ?>
<Window
    x:Class="DotnetManagerUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The built-in WinUI title bar control (WinUI 3 Gallery > TitleBar). It draws the caption
             and follows the app theme itself, so nothing has to be colored through AppWindow. -->
        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            Title=".NET Manager" />

        <!-- Native navigation. Tag carries the Blazor route each item selects; the Content values are
             the fallback labels and are replaced with the localized strings once the shell is live.
             OpenPaneLength is 220: the default 320 leaves too much empty space next to the
             (localized) item labels and squeezes the content area.
             The built-in Settings entry (IsSettingsVisible) opens the settings page, so there is no
             separate 设置 item here - the pane would otherwise list it twice. -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            IsTitleBarAutoPaddingEnabled="False"
            OpenPaneLength="220"
            PaneDisplayMode="Left"
            SelectionChanged="OnNavigationSelectionChanged">

            <!-- Row height for the menu items lives here, in one Resource. -->
            <NavigationView.Resources>
                <Style TargetType="NavigationViewItem">
                    <Setter Property="Height" Value="36" />
                </Style>
            </NavigationView.Resources>

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="ItemOverview" Content="概览" Icon="Home" Tag="/" />

                <!-- Everything that works against the shared project target lives in this one group. -->
                <NavigationViewItemHeader x:Name="GroupProject" Content="项目" />
                <NavigationViewItem x:Name="ItemProjectPackages" Content="项目依赖与安全" Icon="Library" Tag="/nuget/packages" />
                <NavigationViewItem x:Name="ItemTools" Content="工具" Icon="Repair" Tag="/tools" />
                <NavigationViewItem x:Name="ItemGlobalJson" Content="global.json" Icon="Document" Tag="/global-json" />

                <NavigationViewItemHeader x:Name="GroupNuGet" Content="NuGet" />
                <NavigationViewItem x:Name="ItemPackageSources" Content="包源" Icon="List" Tag="/nuget/sources" />
                <NavigationViewItem x:Name="ItemNuGetCaches" Content="缓存" Icon="Save" Tag="/nuget/caches" />
                <NavigationViewItem x:Name="ItemNuGetConfig" Content="配置文件" Icon="Document" Tag="/nuget/config" />

                <!-- Machine wide: nothing in this group reads the project target. -->
                <NavigationViewItemHeader x:Name="GroupEnvironment" Content="环境" />
                <NavigationViewItem x:Name="ItemSdk" Content="SDK 与运行时" Icon="Repair" Tag="/sdk" />
                <NavigationViewItem x:Name="ItemWorkloads" Content="工作负载" Icon="Manage" Tag="/workloads" />
                <NavigationViewItem x:Name="ItemOutput" Content="运行日志" Icon="Page" Tag="/output" />
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
