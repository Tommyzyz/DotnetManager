<?xml version="1.0" encoding="UTF-8" ?>
<Window
    x:Class="DotnetManagerUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The built-in WinUI title bar control (WinUI 3 Gallery > TitleBar). It draws the caption
             and follows the app theme itself, so nothing has to be colored through AppWindow. -->
        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            Title=".NET Manager" />

        <!-- Native navigation. Tag carries the Blazor route each item selects; the Content values are
             the fallback labels and are replaced with the localized strings once the shell is live.
             OpenPaneLength is 220: the default 320 leaves too much empty space next to the
             (localized) item labels and squeezes the content area.
             Items carry Height="36" so every row matches the pane toggle button's 36px row;
             without it the items shrink to their 19px content height and the rows look uneven. -->
        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            PaneDisplayMode="Left"
            OpenPaneLength="220"
            SelectionChanged="OnNavigationSelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItemHeader x:Name="GroupTools" Content="工具" />
                <NavigationViewItem x:Name="ItemOverview" Content="概览" Icon="Home" Tag="/" Height="40" />
                <NavigationViewItem x:Name="ItemLocalTools" Content="本地工具" Icon="Folder" Tag="/tools/local" Height="40" />
                <NavigationViewItem x:Name="ItemGlobalTools" Content="全局工具" Icon="Globe" Tag="/tools/global" Height="40" />
                <NavigationViewItem x:Name="ItemToolSearch" Content="工具搜索" Icon="Find" Tag="/tools/search" Height="40" />

                <NavigationViewItemHeader x:Name="GroupNuGet" Content="NuGet" />
                <NavigationViewItem x:Name="ItemProjectPackages" Content="项目依赖与安全" Icon="Library" Tag="/nuget/packages" Height="40" />
                <NavigationViewItem x:Name="ItemPackageSources" Content="包源" Icon="List" Tag="/nuget/sources" Height="40" />
                <NavigationViewItem x:Name="ItemNuGetCaches" Content="缓存" Icon="Save" Tag="/nuget/caches" Height="40" />
                <NavigationViewItem x:Name="ItemNuGetConfig" Content="配置文件" Icon="Document" Tag="/nuget/config" Height="40" />

                <NavigationViewItemHeader x:Name="GroupEnvironment" Content="环境" />
                <NavigationViewItem x:Name="ItemWorkloads" Content="工作负载" Icon="Manage" Tag="/workloads" Height="40" />
                <NavigationViewItem x:Name="ItemSdk" Content="SDK 与运行时" Icon="Repair" Tag="/sdk" Height="40" />
                <NavigationViewItem x:Name="ItemOutput" Content="运行日志" Icon="Page" Tag="/output" Height="40" />
                <NavigationViewItem x:Name="ItemSettings" Content="设置" Icon="Setting" Tag="/settings" Height="40" />
            </NavigationView.MenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>
    </Grid>
</Window>
