<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Razor">
    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <OutputType>WinExe</OutputType>

        <!-- WinUI 3 -->
        <UseWinUI>true</UseWinUI>
        <EnableMsixTooling>true</EnableMsixTooling>
        <WindowsPackageType>None</WindowsPackageType>
		<IsAotCompatible>true</IsAotCompatible>

        <!-- Project Options -->
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>DotnetManagerUI</RootNamespace>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <EnableDefaultXamlItems>false</EnableDefaultXamlItems>
		<!--<PublishAot>true</PublishAot>-->

        <!-- Target Platform Options -->
        <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>

        <!-- Minimum Target OS Version for Windows Platform -->
        <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>

        <!-- App Options: x64 and arm64 only -->
        <UseRidGraph>true</UseRidGraph>
        <Platforms>x64;arm64</Platforms>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <ApplicationIcon>dotnet-logo.ico</ApplicationIcon>
        <PublishProfile>win-$(Platform).pubxml</PublishProfile>
        <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="DotnetManagerUI.code-workspace" />
        <None Remove="Directory.Packages.props" />
        <None Remove="DotnetManagerUI.slnx" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Web.WebView2" Version="1.*" />
        <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.*" />
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.*" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)" />
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />

        <!-- Moved over from DotnetManager: the services and the headless host need these. -->
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.*" />
        <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />

        <!-- No host file uses a toolkit type - the view models live in DotnetManager.RazorLib and
             import the namespaces themselves. The assembly is still needed at run time, because those
             view models are hosted inside this process's BlazorWebView, so the app project declares the
             dependency it ships instead of relying on it arriving implicitly through the ProjectReference.
             Version is kept in step with the RazorLib reference. -->
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />

        <!-- NuGet's own stack, used by NuGetSettingsService (Configuration) and NuGetPackageQuery
             (Configuration + Protocol). Both are pinned to the same patch: they resolve independently,
             so letting one float while the other is fixed would let them drift onto different
             NuGet.Common versions inside one process. -->
        <PackageReference Include="NuGet.Configuration" Version="7.9.0" />
        <PackageReference Include="NuGet.Protocol" Version="7.9.0" />

        <!-- Not called by our code - do not remove this as an unused reference.
             NuGet.Packaging, pulled in transitively by NuGet.Protocol, depends on
             System.Security.Cryptography.Pkcs 8.0.1, which carries GHSA-2fmv-rv2c-59x7 (moderate) and
             GHSA-846f-f764-76mx (high). 7.9.0 is the newest NuGet release, so there is no upstream
             version to move to. This direct reference is the override that lifts the transitive 8.0.1
             to the patched 10.0.x line; dropping it brings back NU1902 + NU1903 and ships the
             vulnerable assembly. -->
        <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />

        <Manifest Include="$(ApplicationManifest)" />
    </ItemGroup>

    <!-- The pages, view models and localization resources live in the shared Razor class library. -->
    <ItemGroup>
        <ProjectReference Include="..\DotnetManager.RazorLib\DotnetManager.RazorLib.csproj" />
    </ItemGroup>

    <!-- 
        Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
        Tools extension to be activated for this project even if the Windows App SDK Nuget
        package has not yet been restored.
    -->
    <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
        <ProjectCapability Include="Msix" />
    </ItemGroup>

    <!--
        The BlazorWebView loads the host page from the wwwroot folder next to the executable, so every
        asset the page links (index.html, css, favicon) has to be copied to the output directory.
    -->
    <ItemGroup>
        <Content Update="wwwroot\**">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <!-- 
        Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution 
        Explorer "Package and Publish" context menu entry to be enabled for this project even if 
        the Windows App SDK Nuget package has not yet been restored.
    -->
    <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
        <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
    </PropertyGroup>
</Project>
