<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
        <OutputType>WinExe</OutputType>
        <UseWPF>true</UseWPF>

        <!-- Self-contained so the app can start on a machine with no .NET at all and then
             guide the user to install the SDK. -->
        <SelfContained>true</SelfContained>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>

        <PublishAot>true</PublishAot>
        <PublishTrimmed>false</PublishTrimmed>

        <!-- Suppress WPF internal BAML/XAML helper & Blazor Router trimmer reflection warnings -->
        <NoWarn>$(NoWarn);IL2067;IL2075;IL2110;IL2111</NoWarn>

        <!-- Project Options -->
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>DotnetManager</RootNamespace>
        <StartupObject>DotnetManager.Program</StartupObject>
        <!--<PublishAot>true</PublishAot>
        <PublishTrimmed>false</PublishTrimmed>-->
		<PublishSingleFile>true</PublishSingleFile>
        <PackageIcon>dotnet-logo.png</PackageIcon>
        <ApplicationIcon>dotnet-logo.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
      <Content Include="dotnet-logo.ico" />
    </ItemGroup>

    <ItemGroup>
      <None Include="..\DotnetManager.RazorLib\Resources\dotnet-logo.png">
        <Pack>True</Pack>
        <PackagePath>\</PackagePath>
      </None>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.*" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.*" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
        <PackageReference Include="NuGet.Configuration" Version="7.*" />
        <PackageReference Include="NuGet.Protocol" Version="7.*" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DotnetManager.RazorLib\DotnetManager.RazorLib.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Update="wwwroot\css\app.css">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Update="wwwroot\css\bootstrap\bootstrap.min.css">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Update="wwwroot\index.html">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Update="wwwroot\css\font-awesome\**">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <!-- Local development signing.
         Every rebuild produces a new executable hash and SmartScreen evaluates each unknown hash
         again, so the freshly built executable is signed with a certificate trusted only on this
         machine. Create it once per machine with (no admin rights needed):

             $c = New-SelfSignedCertificate -Type CodeSigningCert -Subject 'CN=DotnetManager Dev' `
                  -FriendlyName 'DotnetManager Local Dev Signing' -CertStoreLocation Cert:\CurrentUser\My `
                  -NotAfter (Get-Date).AddYears(10)
             foreach ($s in 'Root','TrustedPublisher') {
                 $store = New-Object System.Security.Cryptography.X509Certificates.X509Store($s,'CurrentUser')
                 $store.Open('ReadWrite'); $store.Add($c); $store.Close()
             }

         The signing runs inline so it cannot depend on a script file, and it never fails the build:
         when the certificate or the output is missing it prints a note and carries on. -->
    <PropertyGroup>
        <DevSignCertificateSubject>CN=DotnetManager Dev</DevSignCertificateSubject>
    </PropertyGroup>

    <Target Name="SignDevBuild" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT' and '$(TargetDir)' != ''">
        <PropertyGroup>
            <_DevSignTarget>$(TargetDir)$(AssemblyName).exe</_DevSignTarget>
        </PropertyGroup>
        <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$exe = '$(_DevSignTarget)'; $mod = Join-Path $PSHOME 'Modules\Microsoft.PowerShell.Security'; if (Test-Path $mod) { Import-Module $mod -ErrorAction SilentlyContinue }; $cert = Get-ChildItem Cert:\CurrentUser\My | Where-Object { $_.Subject -eq '$(DevSignCertificateSubject)' -and $_.NotAfter -gt (Get-Date) } | Select-Object -First 1; if ($null -eq $cert) { Write-Host 'Sign-Dev: no code signing certificate, skipping'; exit 0 }; if (-not (Test-Path $exe)) { Write-Host 'Sign-Dev: executable not found, skipping'; exit 0 }; try { $result = Set-AuthenticodeSignature -FilePath $exe -Certificate $cert -HashAlgorithm SHA256; Write-Host ('Sign-Dev: ' + [System.IO.Path]::GetFileName($exe) + ' -> ' + $result.Status) } catch { Write-Host ('Sign-Dev: failed - ' + $_.Exception.Message) }&quot;"
              ContinueOnError="true"
              StandardOutputImportance="normal"
              StandardErrorImportance="normal" />
    </Target>

    <Target Name="SignDevPublish" AfterTargets="Publish" Condition="'$(OS)' == 'Windows_NT' and '$(PublishDir)' != ''">
        <PropertyGroup>
            <_DevSignPublishTarget>$([System.IO.Path]::GetFullPath('$(PublishDir)'))$(AssemblyName).exe</_DevSignPublishTarget>
        </PropertyGroup>
        <Exec Command="powershell -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$exe = '$(_DevSignPublishTarget)'; $mod = Join-Path $PSHOME 'Modules\Microsoft.PowerShell.Security'; if (Test-Path $mod) { Import-Module $mod -ErrorAction SilentlyContinue }; $cert = Get-ChildItem Cert:\CurrentUser\My | Where-Object { $_.Subject -eq '$(DevSignCertificateSubject)' -and $_.NotAfter -gt (Get-Date) } | Select-Object -First 1; if ($null -eq $cert) { Write-Host 'Sign-Dev: no code signing certificate, skipping'; exit 0 }; if (-not (Test-Path $exe)) { Write-Host 'Sign-Dev: executable not found, skipping'; exit 0 }; try { $result = Set-AuthenticodeSignature -FilePath $exe -Certificate $cert -HashAlgorithm SHA256; Write-Host ('Sign-Dev: ' + [System.IO.Path]::GetFileName($exe) + ' -> ' + $result.Status) } catch { Write-Host ('Sign-Dev: failed - ' + $_.Exception.Message) }&quot;"
              ContinueOnError="true"
              StandardOutputImportance="normal"
              StandardErrorImportance="normal" />
    </Target>

</Project>
