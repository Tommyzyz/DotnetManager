<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk.Razor">

    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
        <OutputType>WinExe</OutputType>
        <UseWPF>true</UseWPF>

        <!-- Self-contained so the app can start on a machine with no .NET at all and then
             guide the user to install the SDK. -->
        <SelfContained>true</SelfContained>
        <RuntimeIdentifier>win-x64</RuntimeIdentifier>

        <PublishAot>true</PublishAot>
        <PublishTrimmed>false</PublishTrimmed>

        <!-- Suppress WPF internal BAML/XAML helper & Blazor Router trimmer reflection warnings -->
        <NoWarn>$(NoWarn);IL2067;IL2075;IL2110;IL2111</NoWarn>

        <!-- Project Options -->
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>DotnetManager</RootNamespace>
        <StartupObject>DotnetManager.Program</StartupObject>
        <!--<PublishAot>true</PublishAot>
        <PublishTrimmed>false</PublishTrimmed>-->
		<PublishSingleFile>true</PublishSingleFile>
        <PackageIcon>dotnet-logo.png</PackageIcon>
        <ApplicationIcon>dotnet-logo.ico</ApplicationIcon>
    </PropertyGroup>

    <ItemGroup>
      <Content Include="dotnet-logo.ico" />
    </ItemGroup>

    <ItemGroup>
      <None Include="..\DotnetManager.RazorLib\Resources\dotnet-logo.png">
        <Pack>True</Pack>
        <PackagePath>\</PackagePath>
      </None>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Wpf" Version="10.*" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.*" />
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.*" />
        <PackageReference Include="NuGet.Configuration" Version="7.*" />
        <PackageReference Include="NuGet.Protocol" Version="7.*" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DotnetManager.RazorLib\DotnetManager.RazorLib.csproj" />
    </ItemGroup>

    <ItemGroup>
        <Content Update="wwwroot\css\app.css">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Update="wwwroot\css\bootstrap\bootstrap.min.css">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Update="wwwroot\index.html">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
        <Content Update="wwwroot\css\font-awesome\**">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <!-- Every rebuild changes the executable hash, and SmartScreen evaluates each unknown
         hash again. Signing the output with the local development certificate (created by
         New-DevCert.ps1, trusted only for the current user) keeps that prompt away.
         The script exits without an error when no certificate exists, so this never breaks a build. -->
    <Target Name="SignDevBuild" AfterTargets="Build" Condition="'$(OS)' == 'Windows_NT' and '$(TargetDir)' != ''">
        <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\Sign-Dev.ps1&quot; -ExePath &quot;$(TargetDir)$(AssemblyName).exe&quot;"
              ContinueOnError="true"
              StandardOutputImportance="normal"
              StandardErrorImportance="normal" />
    </Target>

    <Target Name="SignDevPublish" AfterTargets="Publish" Condition="'$(OS)' == 'Windows_NT' and '$(PublishDir)' != ''">
        <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\Sign-Dev.ps1&quot; -ExePath &quot;$(PublishDir)$(AssemblyName).exe&quot;"
              ContinueOnError="true"
              StandardOutputImportance="low"
              StandardErrorImportance="low" />
    </Target>

</Project>
