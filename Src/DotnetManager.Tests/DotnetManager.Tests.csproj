<?xml version="1.0" encoding="UTF-8" ?>
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- Matches the host application so the WPF services can be referenced as well. -->
        <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
        <UseWPF>true</UseWPF>

        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <LangVersion>latest</LangVersion>
        <RootNamespace>DotnetManager.Tests</RootNamespace>

        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>

        <!-- The host project is self-contained; tests run on the shared runtime instead. -->
        <SelfContained>false</SelfContained>
        <PublishAot>false</PublishAot>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.*" />
        <PackageReference Include="xunit" Version="2.9.*" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.8.*" />
        <PackageReference Include="coverlet.collector" Version="6.*" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DotnetManager.RazorLib\DotnetManager.RazorLib.csproj" />
        <ProjectReference Include="..\DotnetManager\DotnetManager.csproj" />
    </ItemGroup>

</Project>
